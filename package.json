{
  "name": "autocode",
  "version": "1.0.0",
  "description": "Web UI driven autonomous coding harness on top of the Claude Agent SDK",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike:auth": "node scripts/spike-auth.ts",
    "spike:sandbox": "node scripts/spike-sandbox.ts",
    "spike:background": "node scripts/spike-background.ts",
    "make-test-repo": "bash scripts/make-test-repo.sh",
    "create-user": "node scripts/create-user.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.223",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.11.2",
    "pino": "^10.3.1",
    "shell-quote": "^1.10.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/shell-quote": "^1.7.5",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
